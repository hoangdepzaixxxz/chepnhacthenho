{
  "name": "chepnhacthenho",
  "version": "1.8.0",
  "author": "Nguyễn Phi Hoàng",
  "private": true,
  "main": "desktop-main.js",
  "bin": "1.js",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "start": "electron .",
    "build:exe": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "5.16.1",
    "electron": "39.8.10",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.chepnhacthenho.downloader",
    "productName": "AutoMusic Pro",
    "artifactName": "AutoMusicPro-Setup-${version}.${ext}",
    "asar": true,
    "files": [
      "1.js",
      "desktop-main.js",
      "preload.js",
      "lib{,/**/*}",
      "package.json",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "renderer",
        "to": "renderer"
      }
    ],
    "directories": {
      "output": "dist-desktop"
    },
    "win": {
      "signAndEditExecutable": true,
      "icon": "renderer/assets/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "executableName": "AutoMusicPro"
  },
  "overrides": {
    "cheerio": "1.0.0",
    "minimatch": "3.1.4"
  },
  "description": "Phần mềm tự động sao chép và quản lý nhạc trên máy tính, USB và thẻ nhớ."
}
